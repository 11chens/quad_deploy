{
    "version": "0.2.0",
    "configurations": [
    {
        "name": "Python: Attach to Onboard (Port 7890)",
        "type": "debugpy",
        "request": "attach",
        "justMyCode": true,
        "connect": {
            "host": "localhost",
            "port": 7890
        },
        "pathMappings": [
            {
                "localRoot": ".",
                "remoteRoot": "."
            },
            {
                "localRoot": "../ros_base",
                "remoteRoot": "../ros_base"
            },
        ]
    },
    {
        "name": "Python: Attach to VLMPub (Port 8901)",
        "type": "debugpy",
        "request": "attach",
        "connect": {
            "host": "localhost",
            "port": 8901
        },
        "pathMappings": [
            {
                "localRoot": ".",
                "remoteRoot": "."
            }
        ]
    },
]
}
